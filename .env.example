# ─────────────────────────────────────────────────────────────────────────────
# Filum – Konfiguration. Kopieren nach .env und anpassen. Alle Werte: docs/handbuch/15-konfiguration.md
# ─────────────────────────────────────────────────────────────────────────────

# Adresse der Verwaltungsoberfläche (so, wie Benutzer sie im Browser aufrufen)
APP_URL=https://filum.intranet.example.de

# Optional: fertiges Image statt eigenem Build (dann ohne --build starten)
# FILUM_IMAGE=ghcr.io/pbaumfalk/filum:1

# Erste Kurzlink-Domain; wird beim ersten Start als interne Standarddomain angelegt
DEFAULT_DOMAIN=go.intranet.example.de

# Auf welchen Host-Adressen/Ports Docker die Container-Ports anbietet.
# 127.0.0.1 = nur für einen Reverse Proxy auf demselben Server (empfohlen)
# PUBLIC_BIND=0.0.0.0 ohne Proxy davor: dann auch TRUST_PROXY=false setzen (docs/handbuch/14-reverse-proxy.md)
PUBLIC_BIND=127.0.0.1
PUBLIC_HOST_PORT=8080
ADMIN_BIND=127.0.0.1
ADMIN_HOST_PORT=8081

# Zeitzone der Container-Umgebung. Wirkt NICHT auf die Zeitstempel in den Logs und in den
# Dateinamen der Sicherungen: Diese sind immer UTC. Die fachliche Zeitzone (Zeitpläne,
# Tageswerte der Statistik) stellen Sie in Filum unter Einstellungen → Allgemein ein.
TZ=Europe/Berlin

# Optional: Welchen Proxys Filum X-Forwarded-For glaubt. Empfohlen: genau die Adresse des
# Proxys oder das Subnetz des gemeinsamen Docker-Netzes (docs/handbuch/14-reverse-proxy.md)
# TRUST_PROXY=172.18.0.0/16

# Optional: Einrichtungscode selbst festlegen (sonst zufällig, steht im Log)
# SETUP_CODE=

# Optional: Anmeldung über authentik (OIDC)
# OIDC_ISSUER=https://auth.example.de/application/o/filum/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ADMIN_GROUPS=filum-admins
# OIDC_EDITOR_GROUPS=filum-redaktion
# OIDC_MEMBER_GROUPS=
# OIDC_DEFAULT_ROLE=member
# OIDC_BUTTON_LABEL=Mit authentik anmelden
# DISABLE_LOCAL_LOGIN=false

# Optional: Ziele im Intranet für Vorschau und Zielprüfung freigeben (Hostnamen oder Netze)
# FETCH_ALLOW_HOSTS=wiki.intranet.example.de,10.20.0.0/16

# Optional: Tessera (QR-Studio) anbinden
# TESSERA_URL=https://qr.intranet.example.de
# TESSERA_TOKEN=tsr_…

# Sicherungen
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
