{
  "name": "filum",
  "version": "1.0.0",
  "description": "Filum – selbst gehostetes Link-Management-Studio",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cli": "tsx src/server/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "openid-client": "^6.8.1",
    "papaparse": "^5.5.3",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "undici": "^8.12.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fontsource-variable/martian-mono": "^5.2.5",
    "@fontsource-variable/onest": "^5.2.5",
    "@playwright/test": "^1.56.0",
    "@tanstack/react-query": "^5.90.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.0",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.10",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
